    );
}


async function logoutThreatLabUser()
{
    if (Debug)
        console.log('logoutThreatLabUser ENTRY');

    const sessionProps = getSessionProps();

    // logout endpoint.
    return await fetchWrapper.post(
        getBaseUrl() + `/api/app/threatlab/auth/?action=logout&tenantId=${sessionProps.tenantId}`,
        {}
    );
}

async function requestThreatLabAccountDeletion()
{
    if (Debug)
        console.log('requestThreatLabAccountDeletion ENTRY');

    const sessionProps = getSessionProps();
    if (Debug)
        console.log('requestThreatLabAccountDeletion session props: ' + typeof sessionProps, sessionProps);

    /*
     * Gatekeeper owns the deletion policy. For paid plans it should disable
     * access immediately, retain the account through the paid term, then delete.
     */
    const response = await fetchWrapper.post(
        getBaseUrl() + `/api/app/threatlab/account/?action=delete&tenantId=${sessionProps.tenantId}`,
        sessionProps
    );
    if (Debug)
        console.log('requestThreatLabAccountDeletion EXIT response: ', response);
    return response;
}


