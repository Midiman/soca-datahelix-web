 async function sendLoginEvent(type = 'notset', data = '{}')
 {
    try
    {
        if (Debug)
            console.log("sendLoginEvent() ENTRY : type: " + type + ' data: ', data)

        var body = {}
        if (data != undefined)
        {
           body = {... data}
           body['@timestamp'] = new Date().toISOString();
           if (getSessionProps() != undefined)
           {
               body.name = getSessionProps().name,
               body.email = getSessionProps().email,
               body.tenantId = getSessionProps().tenantId
               if (Debug)
                   console.log("sendLoginEvent() : session props body update to:", body)
           }
           else
           if (Debug)
               console.log("sendLoginEvent() : no session props : body:", body)
        }            
        else
        {
           if (Debug)
               console.log("sendLoginEvent() EXIT : No data!")
           return;
        }
        if (Debug)
           console.log("sendLoginEvent() : body: ",body)

        const url = getBaseUrl() + '/api/app/sessions/audit?event=login&type=' + type;
        if (Debug)
            console.log("sendLoginEvent() :url:" + url + " body: ", body)
        
        //Send the audit event . . . . . 
        var response = await fetchWrapper.post(url, body)
            .then(result => 
            {
                if (Debug)
                    console.log("sendLoginEvent() [then] result: ", result)
                return result;
            });
        if (Debug)
            console.log("sendLoginEvent() EXIT resp: ", response);
        return response;
    }
    catch (exc)
    {
        if (Debug)
            console.log("sendLoginEvent() : EXCEPTION! : ", exc)
    }
}

 async function sendLogoutEvent(type = 'notset')
 {
    try
    {
        if (Debug)
             console.log("sendLogoutEvent() ENTRY : type: " + type)

        var body = {}
        body['@timestamp'] = new Date().toISOString()
        if (getSessionProps() != undefined)
        {
            body.user = getSessionProps().email,
            body.name = getSessionProps().name,
            body.email = getSessionProps().email,
            body.tenantId = getSessionProps().tenantId
            if (Debug)
                console.log("sendLogoutEvent() : session props body update to:", body)
        }
        else
        {
            if (Debug)
                console.log("sendLogoutEvent() EXIT : No data!")
            return;
        }
        if (Debug)
            console.log("sendLogoutEvent() : body: ", body)

        const url = getBaseUrl() + '/api/app/sessions/audit?event=logout&type=' + type;
        if (Debug)
            console.log("sendLogoutEvent() :url:" + url + " body: ", body)

        //Send the audit event . . . . . 
        var response = await fetchWrapper.post(url, body)
            .then(result => 
            {
                if (Debug)
                    console.log("sendLogoutEvent() [then] result: ", result)
                return result;
            });
        if (Debug)
            console.log("sendLogoutEvent() EXIT resp: ", response);
        return response;
     }
     catch (exc)
     {
        if (Debug)
            console.log("sendLogoutEvent() : EXCEPTION! : ", exc)
    }
}

