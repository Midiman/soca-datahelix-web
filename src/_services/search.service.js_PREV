async function getAssetScoreTrend(assetId) 
{
    const query = `{"_source":["score","scoreTrend"],"query":{"match":{"assetId.keyword":"${assetId}"}}}`;
    if (Debug)
        console.log("getAssetScoreTrend() vstrend ENTRY : " + query);
    const response = await fetchWrapper.post(getBaseUrl() + `/api/app/search/?index=cmdb_stats_assets*`, query)
    if (Debug)
        console.log("getAssetScoreTrend() vstrend [then] response] : " + JSON.stringify(response));
    if (response != undefined && response.hasOwnProperty("hits"))
    {
        const results = response.hits.hits;
        if (Debug)
            console.log("getAssetScoreTrend() vstrend EXIT results : " + JSON.stringify(results));
        return results;
    }
    if (Debug)
        console.log("getAssetScoreTrend() vstrend EXIT [error] : " + JSON.stringify(response));
    return response;
}

/**
    Helper function for building a tags-based counter elastic query
 */
function buildTagsQuery(tagArray, qprefix, qsuffix)
{
    if (Debug)
        console.log("buildTagsQuery() ENTRY < " + tagArray + " >");
    if (tagArray == undefined)
    {
        if (Debug)
            console.log("buildTagsQuery() EXIT [no tags!] ");
            return '';
    }
    const tags = tagArray.map((elem) =>
    {
        return elem.id;
    })
    if (Debug)
        console.log("buildTagsQuery() tags! " + tags);

    if (qprefix == undefined)
        qprefix = '{"size":0,"track_total_hits":true,"query":{"bool":{"must":[';
    let query = qprefix;
    let idx = 0;
    for (const tag of tags)
    {
        if (Debug)
            console.log("buildTagsQuery() " + tag);
        const keyword = tag.includes(' ') ? '.keyword' : ''
        query += `{"nested":{"path":"tags","query":{"match":{"tags.label${keyword}":"${tag}"}}}}`
        if (idx < (tags.length - 1))
            query += ','
        idx++;
    }
    query += qsuffix != undefined ? qsuffix : ']}}}';
    if (Debug)
        console.log("buildTagsQuery() EXIT ---> " + query);
    return query;
}

async function getTotalAssets(tags)
{
    let query = '{"size":0,"track_total_hits": true,"query":{"match_all":{}}}';
    if (Debug)
        console.log("getTotalAssets() ENTRY tags? " + (tags != undefined && tags.length > 0 ? tags.length + " => " + Object.keys(tags[0]) : "false"));
    if (tags != undefined && tags.length > 0)
    {
        if (Debug)
            console.log("getTotalAssets() QUERYING... : " + tags);
        query = buildTagsQuery(tags);
        if (Debug)
            console.log("getTotalAssets() QUERY ---> " + query);
    }
    var response = await fetchWrapper.post(getBaseUrl() + `/api/app/search/?index=cmdb_assets*`, query);
    if (Debug)
        console.log("getTotalAssets() EXIT : " + JSON.stringify(response));
    try
    {
        const result = response.hits.total.value.value
        if (Debug)
            console.log("getTotalAssets() [tags] EXIT : " + result);
        return result;
    }
    catch (ex)
    {
        if (Debug)
            console.log("getTotalAssets() EXIT [EXCEPTION]: " + ex);
        return ex;
    }
}

