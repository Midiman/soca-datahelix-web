        { subject, message }
    );
}

async function loginUser({ username = null, email = null, password })
{
    const userId = (email || username || '').trim().toLowerCase();

    if (Debug)
        console.log('loginUser ENTRY', userId);

    const sessionProps = getSessionProps();

    // Placeholder Gatekeeper login endpoint.
    return await fetchWrapper.post(
        getBaseUrl() + `/api/app/threatlab/auth/?action=login&tenantId=${sessionProps.tenantId}`,
        {
            email: userId,
            password
        }
    );
}


async function createUser({ name, email, password })
{
    if (Debug)
        console.log('createUser ENTRY', name, email);

    /*
     * Legacy AuthPage signup hook. ThreatLab should normally use the verified
     * Signup flow instead, so this remains a separate placeholder.
     */
    return await fetchWrapper.post(
        getBaseUrl() + '/api/threatlab/user',
        {
            name,
            email,
            password
        }
    );
}
