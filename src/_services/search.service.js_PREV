async function isTestModeRunning()
{
    if (Debug)
        console.log("isTestModeRunning PT1d ENTRY ");
    try
    {
        const tid = getSessionProps().tenantId;
        if (tid == undefined)
        {
            if (Debug)
                console.log("isTestModeRunning PTNOTID");
            return null;
        }
        let url = getBaseUrl() + `/api/app/testmode/?operation=status&tenantId=${tid}`;

        if (Debug)
            console.log("isTestModeRunning() PT1d url: " + url);
        const response = await fetchWrapper.get(url)
                    .then((resp) => 
                    {
                        if (Debug)
                            console.log('isTestModeRunning() PT1d [then]: ',resp);
                        return resp;
                    });
        if (Debug)
            console.log("isTestModeRunning PT1d EXIT response: ", response);
        return response;
        // var result = response;
        // if (Debug)
        //     console.log("isTestModeRunning PT1d EXIT results: ", result);
        // return result?.message === 'true' ? true : false;
    }
    catch (exc)
    {
        if (Debug)
            console.log("isTestModeRunning PT1d EXCEPTION",exc);
        return {enabled:false,verbosity:5}
    }
}

async function testModeOperation(enable, verbosityLevel, generateSafeEvents = false)
{
    if (Debug)
        console.log("testModeOperation PT1c ENTRY ",enable, verbosityLevel);
    try
    {
        const tid = getSessionProps().tenantId;
        if (tid == undefined)
        {
            if (Debug)
                console.log("isTestModeRunning PTNOTID");
            return null;
        }
        let url = getBaseUrl() + `/api/app/testmode/?operation=${enable ? 'start' : 'stop'}&verbosity=${verbosityLevel}&generateSafeEvents=${generateSafeEvents}&tenantId=${tid}`;

        if (Debug)
            console.log("testModeOperation() url: " + url);
        const response = await fetchWrapper.get(url);
        if (Debug)
            console.log("testModeOperation EXIT response: ", response);


        var result = response;
        if (Debug)
            console.log("testModeOperation EXIT results: ", result);
        return result;
    }
    catch (exc)
    {
        if (Debug)
            console.log("testModeOperation EXCEPTION",exc);
        return {
            status: 400,
            message: 'Error setting Test Mode' + exc.message
        }
    }
}

/**
 * Generates a verification code email request to send to the specified email.
 */
async function requestThreatLabSignupCode({
    email,
    plan = null,
    billingPeriod = null,
    currency = null,
    termsVersion = null
})
{
    if (Debug)
        console.log('requestThreatLabSignupCode ENTRY', email, plan);

    const sessionProps = getSessionProps();

    const body = {
        email,
        plan,
        billingPeriod,
        currency,
        termsVersion
    };

    return await fetchWrapper.post(
        getBaseUrl() + `/api/app/threatlab/signup/verification/?action=generate&tenantId=${sessionProps.tenantId}`,
        body
    );
}

/**
 * Generates a verify request for the code generated by the email request inrequestThreatLabSignupCode.
 */
async function verifyThreatLabSignupCode({ email, code })
{
    if (Debug)
        console.log('verifyThreatLabSignupCode ENTRY', email);

    const sessionProps = getSessionProps();

    // Expected success: { ok: true, verificationToken: '...' }
    return await fetchWrapper.post(
        getBaseUrl() + `/api/app/threatlab/signup/verification/?action=verify&tenantId=${sessionProps.tenantId}`,
        { email, code }
    );
}

/**
 * Makes a create user request.
 */
async function createThreatLabAccount({
    plan,
    billingPeriod = null,
    currency = null,
    name,
    email,
    password,
    mfaEnabled = false,
    mfaMethod = null,
    verificationToken,
    termsAccepted,
    termsVersion
})
{
    if (Debug)
        console.log('createThreatLabAccount ENTRY', email, plan);

    const sessionProps = getSessionProps();

    const body = {
        plan,
        billingPeriod,
        currency,
        name,
        email,
        password,
        mfaEnabled,
        mfaMethod,
        verificationToken,
        termsAccepted,
        termsVersion
    };

    // Free plan reaches this directly. Paid checkout will sit before this call.
    return await fetchWrapper.post(
        getBaseUrl() + `/api/app/threatlab/signup/?action=create&tenantId=${sessionProps.tenantId}`,
        body
    );
}


async function getThreatLabSession()
{
    if (Debug)
        console.log('getThreatLabSession ENTRY');

    const sessionProps = getSessionProps();

