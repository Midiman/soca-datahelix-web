export function getBaseUrl()
{
    let sessionProps = JSON.stringify(getSessionProps());

    if (Debug)
        console.log("SWC : getBaseUrl() ENTRY : " + sessionProps);
    if (sessionProps != undefined)
    {
        sessionProps = JSON.parse(sessionProps);
        if (Debug)
            console.log("SWC : getBaseUrl() appliance : " + sessionProps.appliance);
    }
    else
    {
        if (Debug)
            console.log("SWC : getBaseUrl() appliance : none - it's undefined.");
        let srv = sessionStorage.getItem('loginServer')
        if (Debug)
            console.log("SWC : getBaseUrl() loginserver srv: " + srv);
        if (srv == undefined)
        {
            if (Debug)
                console.log("SWC : getBaseUrl() appliance : no loginserver defined")
            srv = "login.socautomation.com"
        }
        sessionProps = { appliance: srv};
        if (Debug)
        {
            console.log("SWC : getBaseUrl() appliance : is now? ");
            console.log("SWC : getBaseUrl() appliance : is now: ",sessionProps);
        }
    }
    var port = '';
    if (window.API_SRV_PORT)
        port = ':' + window.API_SRV_PORT;
    if (Debug)
        console.log("SWC : getBaseUrl() [parsed] : " + JSON.stringify(sessionProps));
    let baseUrl = `https://` + sessionProps.appliance + port;
    if (Debug)
        console.log("SWC : getBaseUrl() EXIT : " + baseUrl);
    return baseUrl;
}

async function doSearch(index = `cmdb_asset*`, search = `{"size":10,"track_total_hits": true,"query":{"match_all":{}}}`) 
{
    let url = getBaseUrl() + `/api/app/search/?index=${index}`;
    let dsearch = `${search}`;
    if (Debug)
        console.log("doSearch() ENTRY  url: " + url + " srch: " + dsearch);
    var response = await fetchWrapper.post(url, dsearch)            
        .then(result => 
        {
            if (Debug)
                console.log("doSearch() [then] result: " + response + " : " + result)
            return result;
        });
    if (Debug)
        console.log("doSearch() EXIT : " + JSON.stringify(response));
    return response;
}

async function doFilteredSearch(index, fields, terms) 
{
    let search = {}
    if (fields != undefined)
        search._source = fields;

    let query = {};
    if (terms != undefined)
        query.query = { terms: terms };
    else
        query.query = { match_all: {} };
    search.query = query;
    const searchString = JSON.stringify(search);
    if (Debug)
        console.log("doFilteredSearch() search: " + searchString)

    let url = getBaseUrl() + `/api/app/search/?index=${index}`;
    if (Debug)
        console.log("doFilteredSearch() ENTRY  url: " + url + " srch: " + searchString);
    var response = await fetchWrapper.post(url, searchString)            
        .then(result => 
        {
            if (Debug)
                console.log("doFilteredSearch() [then] result: " + response + " : " + result)
            return result;
        });
    if (Debug)
        console.log("doFilteredSearch() EXIT : " + JSON.stringify(response));
    return response;
}


async function getRiskMapTags()
{
    const loginUrl = sessionStorage.getItem('loginServer');
    try
    {
        if (Debug)
            console.log("getRiskMapTags() ENTRY DualSelector " + loginUrl)
        var resp = await fetchWrapper.get(`https://${loginUrl}/api/rbvm/riskmap?action=gettags`)
            .then(result => {
                console.log("getRiskMapTags() [then] DualSelector resp: " + resp + " : " + result)
                return result;
            });
        if (Debug)
            console.log("getRiskMapTags() EXIT DualSelector resp: " + JSON.stringify(resp))
        return resp;
    }
    catch (exc)
    {
        if (Debug)
            console.log("getRiskMapTags() DualSelector EXCEPTION! " + exc.message)
        let msg = exc.message.includes('Failed to fetch') ? "Unable to contact server" : exc.message;
        return { "ok": false, "status": 502, "error": msg, "statusText": msg };
    }
}

async function getStakeholders(fields)
{
    const loginUrl = sessionStorage.getItem('loginServer');
    try
    {
        const url = `https://${loginUrl}/api/rbvm/stakeholder?type=all` + (fields != undefined ? `&fields=${fields}` : '');
        if (Debug)
            console.log("getStakeholders() renderAddStakeholderContent ENTRY url: " + url)
        var resp = await fetchWrapper.get(url)
            .then(result => {
                console.log("getStakeholders() [then] resp: ",resp,result)
                return result;
            });
        if (Debug)
            console.log("getStakeholders() EXIT resp: " + JSON.stringify(resp))
        return resp;
    }
    catch (exc)
    {
        if (Debug)
            console.log("getStakeholders() EXCEPTION! " + exc.message)
        let msg = exc.message.includes('Failed to fetch') ? "Unable to contact server" : exc.message;
        return { "ok": false, "status": 502, "error": msg, "statusText": msg };
    }
}

