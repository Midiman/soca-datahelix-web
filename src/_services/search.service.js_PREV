/**
  Retrieves and extracts the top most vunerable machines and their associated count
  Return an object ready for chart ingestion
*/
async function getTopVulnerableAssets(top = 5, tags)
{
    try
    {   
        if (Debug)
            console.log("getTopVulnerableAssets() ENTRY top: " + top + " tags? " + (tags != undefined ? tags.length : "false"));
        //aggs query - this one searches only for criticals
        let query = `{"size":0,"_source":["machineId", "severity", "score"],  "query": { "bool": { "must": [ { "term": { "severity": "critical" } } ] } }, "aggs": { "group_by_device": { "terms": { "field": "machineId.keyword" }, "aggs": { "theMax": { "top_hits": { "size": "1", "_source": ["machineId", "machineName", "severity", "score"],  "sort": { "machineId.keyword": { "order": "desc" }}}}}}}}`;


//TODO ADD TAGS
//This query builder doesn't work for cmdb_machine_vulnerabilities because this index doesn't hold a tags[]
        // if (tags != undefined && tags.length > 0)
        // {
        //     if (Debug)
        //         console.log("getTopVulnerableAssets() QUERYING... : " + tags);
        //     query = buildTagsQuery(tags, 
        //                            '{"size":0,"_source":["machineId", "severity", "score"],  "query": { "bool": { "must": [ { "term": { "severity": "critical" } },', 
        //                            '] } }, "aggs": { "group_by_device": { "terms": { "field": "machineId.keyword" }, "aggs": { "theMax": { "top_hits": { "size": "1", "_source": ["machineId", "machineName", "severity", "score"],  "sort": { "machineId.keyword": { "order": "desc" }}}}}}}}'
        //                           );
        //     if (Debug)
        //         console.log("getTopVulnerableAssets() QUERY ---> " + query);
        // }

//        var response = await fetchWrapper.post(getBaseUrl() + `/api/app/search/?index=cmdb_machine_vulnerabilities*`, query);
        var response = await fetchWrapper.post(getBaseUrl() + `/api/app/search/?index=cmdb_machine_vulnerabilities*`, `{"size":0,"_source":["machineId", "severity", "score"],  "query": { "bool": { "must": [ { "term": { "severity": "critical" } } ] } }, "aggs": { "group_by_device": { "terms": { "field": "machineId.keyword" }, "aggs": { "theMax": { "top_hits": { "size": "1", "_source": ["machineId", "machineName", "severity", "score"],  "sort": { "machineId.keyword": { "order": "desc" }}}}}}}}`);
        if (Debug)
            console.log("getTopVulnerableAssets() [1] response : " + JSON.stringify(response));
        if (response != undefined && response.aggregations != undefined && response.aggregations.group_by_device != undefined && response.aggregations.group_by_device.buckets != undefined )
        {
            if (Debug)
                console.log("getTopVulnerableAssets() response Got a buckets array");
            let result = {};
            let idx = 0;
            for (let bucket of response.aggregations.group_by_device.buckets)
            {
                if (idx >= top)
                    break;
                let aquery = `{"size": 1,"_source": ["name"],"query":{"match":{"_id": "` + bucket.key + `"}}}`;
                if (Debug)
                    console.log("getTopVulnerableAssets() asset query: " + aquery);
                var assetResp = await fetchWrapper.post(getBaseUrl() + `/api/app/search/?index=cmdb_asset*`, aquery);
                if (Debug)
                    console.log("getTopVulnerableAssets() asset resp: " + JSON.stringify(assetResp));
                if (assetResp != undefined && assetResp.hits != undefined && assetResp.hits.hits != undefined)
                result[assetResp.hits.hits[0].name] = bucket.theMax.hits.total.value;
                idx++;
            }
            if (Debug)
                console.log("getTopVulnerableAssets() final pushed result: " + JSON.stringify(result));
            return result;
        }
        else
        if (Debug)
            console.log("getTopVulnerableAssets() response Didn't get any aggs buckets");
    }
    catch (ex)
    {
        if (Debug)
            console.log("getTopVulnerableAssets() [1] EXCEPTION : " + ex);
        return {'data error':0};
    }
    return {'No data':0};
}

/**
  Retrieves and extracts counts of platform types
  Return an array ready for chart ingestion
*/
async function getPlatforms(top = 10, tags)
{
    try
    {   
        if (Debug)
            console.log("getPlatforms() ENTRY top: " + top + " tags? " + (tags != undefined ? tags.length : "false"));
        let query = `{"size": 0,"query":{"match_all": {}},"aggs":{"platforms":{"terms":{"size": "` + top + `","field": "type.keyword" }}}}`;
        //TAG QUERY BUILDER
        if (tags != undefined && tags.length > 0)
        {
            if (Debug)
                console.log("getPlatforms() QUERYING... : " + tags);
            query = buildTagsQuery(tags, null, `]}},"aggs": {"platforms":{"terms":{"size": "${top}","field": "type.keyword"}}}}`);
            if (Debug)
                console.log("getPlatforms() QUERY ---> " + query);
        }
        var response = await fetchWrapper.post(getBaseUrl() + `/api/app/search/?index=cmdb_asset*`, query);
        if (Debug)
            console.log("getPlatforms() [1] response : " + JSON.stringify(response));
        if (response != undefined && response.aggregations != undefined && response.aggregations.platforms != undefined && response.aggregations.platforms.buckets != undefined )
        {
            let others = 0;
            if (Debug)
                console.log("getPlatforms() response Got a buckets array");
            let result = [];
            let idx = 0;
            for (let bucket of response.aggregations.platforms.buckets)
            {
                if (idx >= top || bucket.key.trim() == 0 || bucket.key.trim() === 'notset')
                {
                    others += bucket.doc_count;
                    continue;
                }
                result.push([bucket.key, bucket.doc_count]);
                idx++;
            }
            if (others > 0)
                result.push(['Others', others]);
            if (Debug)
                console.log("getPlatforms() final pushed result: " + JSON.stringify(result));
            return result;
        }
        else
        if (Debug)
            console.log("getPlatforms() response Didn't get any aggs buckets");
    }
    catch (ex)
    {
        if (Debug)
            console.log("getPlatforms() [1] EXCEPTION : " + ex);
        return {'data error':0};
    }
    return {'No data':0};
}

/**
  Retrieves and extracts the severity counts
  Return an object ready for chart ingestion, sorted by severity
*/
async function getSeverities(tags)
{
    try
    {   
        if (Debug)
            console.log("getSeverities() ENTRY top: " + top + " tags? " + (tags != undefined ? tags.length : "false"));

//TODO ADD TAGS
//TAG builder won't work here because cmdb_machine_vulnerabiities doesn't hold tag[]

        var response = await fetchWrapper.post(getBaseUrl() + `/api/app/search/?index=cmdb_machine_vulnerabilities*`, `{"size":0,"aggs":{"severities":{"terms":{"field":"severity.keyword"}}}}`);
        if (Debug)
            console.log("getSeverities() [1] response : " + JSON.stringify(response));
        if (response != undefined && response.aggregations != undefined && response.aggregations.severities != undefined && response.aggregations.severities.buckets != undefined )
        {
            let unsortedResult = {};
            for (let bucket of response.aggregations.severities.buckets)
                unsortedResult[bucket.key] = bucket.doc_count;
            let result = {};
            result = {...result, 'Critical':unsortedResult.hasOwnProperty('critical') ? unsortedResult.critical : 0};
            result = {...result, 'High':unsortedResult.hasOwnProperty('high') ? unsortedResult.high : 0};
            result = {...result, 'Medium':unsortedResult.hasOwnProperty('medium') ? unsortedResult.medium : 0};
            result = {...result, 'Low':unsortedResult.hasOwnProperty('low') ? unsortedResult.low : 0};
            result = {...result, 'Info':unsortedResult.hasOwnProperty('info') ? unsortedResult.info : 0};
            if (Debug)
                console.log("getSeverities() final pushed severities: " + JSON.stringify(result));
            return result;
        }
        else
        if (Debug)
            console.log("getSeverities() response Didn't get any aggs buckets");
    }
    catch (ex)
    {
        if (Debug)
            console.log("getSeverities() [1] EXCEPTION : " + ex);
        return {'data error':0};
    }
    return {'No data':0};
}

/**
  Retrieves a date_histogram
  @param index: the possibly wildcard) index name
  @param field: the name of the field to aggregate
  @param range: elastic-friendly Object with the range: example: {"gte":4.0, "lt":6.0}
  @param dateRange: elastic-friendly date or date match object for date range: example: {"gte":"now-9M/M", "lt":"now"} or {"gte":"now-9M/M"}
  @param timeField: the time field to aggregate. Default is @timestamp
  @param interval: Optional field to specify the time range. Default is 'day'
*/
async function getTimeline(index, field, range, dateRange, timeField = '@timestamp', interval = 'day', tags)
{
    try
    {   
        if (Debug)
            console.log("getTimeline() ENTRY index: " + index + " field: " + field + " range: " + range + " dateRange: " + dateRange + " timefield: " + timeField + " tags? " + (tags != undefined ? tags.length : "false"));

//TODO ADD TAGS
//The tag builder won't work with cmdb_machine_vulnerabilities as it doesn't hold any tags[]

        let request = `{"size":0,"query":{"bool":{"must":[{"range":{"` + timeField + `":` + dateRange + `}},{"range":{"` + field + `":` + range + `}}]}},"aggs":{"timeline":{"date_histogram":{"field":"` + timeField + `","calendar_interval":"` + interval + `"}}}}`;
        if (Debug)
            console.log("getTimeline() request: " + request);
        var response = await fetchWrapper.post(getBaseUrl() + `/api/app/search/?index=` + index, request);
        if (Debug)
            console.log("getTimeline() [1] response : " + JSON.stringify(response));
        if (response != undefined && response.aggregations != undefined && response.aggregations.timeline != undefined && response.aggregations.timeline.buckets != undefined )
        {
            if (Debug)
                console.log("getTimeline() response Got a buckets array");
            let result = [];
            for (let bucket of response.aggregations.timeline.buckets)
            {
                if (Debug)
                    console.log("getTimeline() bucket: " + JSON.stringify(bucket));
                result = [...result, [bucket.key, bucket.doc_count]];
            }
            if (Debug)
                console.log("getTimeline() final pushed result: " + JSON.stringify(result));
            return result;
        }
        else
        if (Debug)
            console.log("getTimeline() response Didn't get any aggs buckets");
    }
    catch (ex)
    {
        if (Debug)
            console.log("getTimeline() [1] EXCEPTION : " + ex);
        return {'data error':0};
    }
    return {'No data':0};
}

export async function tenancyOperation(tenancy, action) {
    if (Debug) 
        console.log('tenancyOperation() ENTRY : ', tenancy, action)
    const url = getBaseUrl() + `/api/app/tenancy?action=${action}`
    if (Debug) 
        console.log('tenancyOperation() : url = ', url)

    var response = await fetchWrapper.post(url, tenancy)
        .then(result => {
            if (Debug) 
                console.log('tenancyOperation() : [then] : response result :', result)
            return result
        })
    if (Debug) 
        console.log('tenancyOperation() : EXIT :', response)
    return response
}

export async function passwordChangeRequest(pwd, tpar)
{
    if (Debug) 
        console.log('passwordChangeRequest() ENTRY :', pwd + " : " + tpar)
    const url = getBaseUrl() + `/api/auth/fpwdtpar`
    if (Debug) 
        console.log('passwordChangeRequest() : url = ', url)

    try
    {
        const body =
        {
            pwd: pwd,
            tpar: tpar
        }
        var response = await fetchWrapper.post(url, body)
            .then(result => {
                if (Debug) 
                    console.log('passwordChangeRequest() : [then] : response result :', result)
                return result
            })
        if (Debug) 
            console.log('passwordChangeRequest() : EXIT :', response)
        return response
    }
    catch (exc)
    {
        if (Debug) 
            console.log('passwordChangeRequest() : EXCEPTION!', exc)
        return exc
    }
 }

