<!DOCTYPE html>
<html class="mail-html" lang="en">
<head>
    <title>ThreatLab commercial enquiry</title>
    <meta name="title" content="ThreatLab commercial enquiry"/>
    <meta charset="utf-8"/>
    <style>
        html {
            height: 100%;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            background-color: #4B5B5B;
        }

        body {
            margin: 0;
            padding: 1em;
            font-family: Arial, Roboto, Sans-Serif;
            font-size: 16px;
            font-weight: normal;
            color: #333;
            background-color: #FFFFFF;
        }

        .mail-body,
        .mail-html {
            color: #333;
            background-color: #FFFFFF;
        }

        .mail-header {
            width: 100%;
            color: #333;
            font-size: 1em;
        }

        .mail-header span {
            display: inline-block;
            width: 100%;
            text-align: right;
        }

        .divider {
            border: 0;
            border-top: 1px solid #555555;
        }

        .mail-message {
            max-width: 760px;
            margin: 0 auto;
            line-height: 1.5;
        }

        .enquiry-title {
            margin: 1.25em 0 0.35em;
            color: #3A4B4B;
            font-size: 1.55em;
            font-weight: bold;
        }

        .enquiry-table {
            width: 100%;
            margin: 1.2em 0;
            border-collapse: collapse;
        }

        .enquiry-table td {
            padding: 0.55em 0.7em;
            border-bottom: 1px solid #E0E4E4;
            vertical-align: top;
        }

        .enquiry-table .label {
            width: 145px;
            color: #5A6666;
            font-weight: bold;
        }

        .message-box {
            margin: 1em 0;
            padding: 1em;
            border-left: 4px solid #408080;
            background-color: #F4F7F7;
            white-space: pre-wrap;
        }

        .reply-link {
            display: inline-block;
            margin: 0.8em 0 1.2em;
            padding: 0.65em 1em;
            border-radius: 4px;
            color: #FFFFFF !important;
            background-color: #408080;
            text-decoration: none;
        }

        .copyright {
            color: #333;
            font-size: 0.65em;
            margin-bottom: 1em;
            text-align: right;
        }

        .copyright a {
            color: #333;
            text-decoration: none;
        }
    </style>
</head>
<body class="mail-body">

    ## Expected context values:
    ## name, company, email, interest, message
    ## Optional: submittedAt, tenantId

    <div class="mail-header">
        <span>ThreatLab Commercial Enquiry</span>
        <hr class="divider"/>
    </div>

    <div class="mail-message">
        <div class="enquiry-title">New ThreatLab commercial enquiry</div>

        <p>
            A commercial enquiry has been submitted through ThreatLab.
        </p>

        <table class="enquiry-table">
            <tr>
                <td class="label">Name</td>
                <td>$name</td>
            </tr>
            <tr>
                <td class="label">Company</td>
                <td>$company</td>
            </tr>
            <tr>
                <td class="label">Work email</td>
                <td>$email</td>
            </tr>
            <tr>
                <td class="label">Interest</td>
                <td>$interest</td>
            </tr>
#if($submittedAt)
            <tr>
                <td class="label">Submitted</td>
                <td>$submittedAt</td>
            </tr>
#end
#if($tenantId)
            <tr>
                <td class="label">Tenant</td>
                <td>$tenantId</td>
            </tr>
#end
        </table>

        <div class="message-box">$message</div>

        <a href="mailto:$email" class="reply-link">Reply to enquiry</a>

        <p>
            This message was generated by the ThreatLab commercial enquiry form.
        </p>
    </div>

    <hr class="divider"/>

    <div class="copyright">
        Powered by
        <a href="https://socautomation.com" target="_blank">
            SOCAutomation<sup style="font-size:0.5em">TM</sup>
        </a>
    </div>

</body>
</html>
