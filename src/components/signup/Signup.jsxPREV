import React, { useEffect, useMemo, useState } from 'react';
import { searchService } from '../../_services/search.service';
import { Debug } from '@/util/Utilities';

import { SignupComplete } from './SignupComplete';
import { SignupForm } from './SignupForm';
import { SignupPricing } from './SignupPricing';
import { SignupPricingStreaming } from './SignupPricingStreaming';
import { SignupTerms } from './SignupTerms';
import { SignupVerifyEmail } from './SignupVerifyEmail';
import { StreamingOnboarding } from './StreamingOnboarding';
import { CommercialContactModal } from './CommercialContactModal';

import { MFASetup } from '../auth/mfa';


const INITIAL_SIGNUP_DATA = {
    name: '',
    email: '',
    password: '',
    confirmPassword: '',
    mfaEnabled: true,
    mfaMethod: 'authenticator',
    acceptTerms: false
};


const Signup = ({
    onLogin = null,
    onCancel = null,
    onContact = null,
    navigationStep = 'pricing',
    onNavigateStep = null,
    onReplaceStep = null,
    onNavigateBack = null,
    pricingMode = 'saas',
    upgradeMode = false,
    currentUser = null
}) =>
{
    const [step, setStep] = useState(navigationStep || 'pricing');
    const [showTermsModal, setShowTermsModal] = useState(false);
    const [selectedPlan, setSelectedPlan] = useState(null);
    const [signupData, setSignupData] = useState(INITIAL_SIGNUP_DATA);
    const [showBusy, setShowBusy] = useState(false);
    const [alert, setAlert] = useState(null);
    const [emailVerificationToken, setEmailVerificationToken] = useState(null);
    const [mfaCompletion, setMfaCompletion] = useState(null);
    const [commercialInterest, setCommercialInterest] = useState(null);


    /*
     * Browser Back/Forward changes navigationStep externally.
     * Local navigation is also changed immediately by this component so
     * transient signup state can never race the parent navigation state.
     */
    useEffect(() =>
    {
        setStep(navigationStep || 'pricing');
    }, [navigationStep]);


    /*
     * Browser history survives a refresh, but selectedPlan/signupData do not.
     * Repair any restored step whose transient prerequisites no longer exist.
     *
     * renderStep() performs the same checks synchronously so an invalid child
     * component is never rendered while this effect is waiting to run.
     */
    useEffect(() =>
    {
        const invalidForm =
            step === 'form' &&
            !selectedPlan;

        const invalidVerify =
            step === 'verify' &&
            (
                !selectedPlan ||
                !signupData?.email ||
                !signupData?.password
            );

        const invalidMfa =
            step === 'mfa' &&
            (
                !signupData?.email ||
                !signupData?.password ||
                !emailVerificationToken
            );

        if (
            !invalidForm &&
            !invalidVerify &&
            !invalidMfa
        )
        {
            return;
        }

        setAlert(null);
        setStep('pricing');

        if (onReplaceStep)
            onReplaceStep('pricing');

    }, [
        step,
        selectedPlan,
        signupData?.email,
        signupData?.password,
        emailVerificationToken,
        onReplaceStep
    ]);


    const branding = useMemo(() =>
    {
        const b = window.BRANDING || {};

        return {
            termsVersion:
                window.BRANDING_TERMS_VERSION ||
                b.TERMS_VERSION ||
                '2026-09',

            privacyUrl:
                window.BRANDING_PRIVACY_URL ||
                b.PRIVACY_URL ||
                null,

            termsUrl:
                window.BRANDING_TERMS_URL ||
                b.TERMS_URL ||
                null
        };
    }, []);


    function getResponseError(response, fallback)
    {
        if (!response)
            return fallback;

        if (
            response?.ok === false ||
            response?.status >= 400 ||
            response?.error
        )
        {
            return response.error || response.message || fallback;
        }

        return null;
    }


    function replaceStep(nextStep)
    {
        /*
         * Update locally first.
         *
         * This is important when clearing transient signup state: the component
         * must already be on the destination step before password/plan state is
         * changed, otherwise a stale Verify render can trigger the refresh guard.
         */
        setStep(nextStep);

        if (onReplaceStep)
            onReplaceStep(nextStep);
    }


    function navigateStep(nextStep)
    {
        setStep(nextStep);

        if (onNavigateStep)
            onNavigateStep(nextStep);
    }


    function completeSignup()
    {
        if (Debug)
            console.log('completeSignup ENTRY');

        /*
         * Move to Complete before clearing the password.
         *
         * This prevents the Verify prerequisite guard from seeing an empty
         * password while the old Verify step is still active.
         */
        replaceStep('complete');

        setSignupData(current => ({
            ...current,
            password: '',
            confirmPassword: ''
        }));

        setEmailVerificationToken(null);
        setMfaCompletion(null);
        setAlert(null);
    }


    /*
     * Creates the ThreatLab account.
     *
     * This is the LAST step of signup and must only run once every prior
     * verification step that is required has already succeeded: email
     * verification always, and - when MFA is enabled - MFA enrolment too.
     *
     * It must never run before MFA setup completes. Creating the account
     * first and enrolling MFA afterwards is what orphans an account: if MFA
     * setup is then aborted (closed tab, browser Back, network drop), the
     * account already exists server-side but can never finish enrolling,
     * leaving it stranded with no way for the user to recover into it.
     *
     * verificationToken proves the email step already succeeded;
     * mfaVerificationToken (when present) proves MFA enrolment already
     * succeeded. Both are short-lived/single-use and are only ever consumed
     * here, in this one final call - so a single successful call to this
     * function is the only thing that can ever bring the account into
     * existence.
     */
    async function createAccount({
        verificationToken,
        mfaVerificationToken = null,
        mfaMethod = null
    })
    {
        /*
         * This should already be guaranteed by renderStep(), but keep the
         * operation itself defensive as well. Signup must never dereference
         * missing transient state.
         */
        if (
            !selectedPlan?.id ||
            !signupData?.email ||
            !signupData?.password
        )
        {
            setAlert(null);
            replaceStep('pricing');
            return;
        }

        setShowBusy(true);
        setAlert(null);

        try
        {
            const response = await searchService.createThreatLabAccount({
                plan: selectedPlan.id,
                billingPeriod: selectedPlan.billingPeriod,
                currency: selectedPlan.currency,
                name: signupData.name?.trim?.() || '',
                email: signupData.email.trim().toLowerCase(),
                password: signupData.password,
                mfaEnabled: signupData.mfaEnabled === true,
                mfaMethod: signupData.mfaEnabled
                    ? (mfaMethod || signupData.mfaMethod)
                    : null,
                verificationToken,
                mfaVerificationToken,
                termsAccepted: true,
                termsVersion: branding.termsVersion
            });

            const responseError = getResponseError(
                response,
                'Unable to create your account.'
            );

            if (responseError)
                throw new Error(responseError);

            completeSignup();
        }
        catch (err)
        {
            console.error('ThreatLab account creation error', err);
            setAlert(err?.message || 'Unable to create your account.');
        }
        finally
        {
            setShowBusy(false);
        }
    }


    /*
     * Email verification has just succeeded.
     *
     * With MFA off there is no further step that could be abandoned, so the
     * account can be created immediately, same as before.
     *
     * With MFA on, account creation must wait: move to MFA setup first and
     * only create the account once MFA enrolment actually succeeds (see
     * completeMfaSetup below). Nothing here persists an account.
     */
    async function handleEmailVerified(verificationToken)
    {
        if (
            !selectedPlan?.id ||
            !signupData?.email ||
            !signupData?.password
        )
        {
            setAlert(null);
            replaceStep('pricing');
            return;
        }

        setAlert(null);
        setEmailVerificationToken(verificationToken);

        if (!signupData.mfaEnabled)
        {
            await createAccount({ verificationToken });
            return;
        }

        /*
         * Do not clear the signup password here.
         * Authenticator/Passkey setup can still use the email/password
         * compatibility path when no setup token is available.
         */
        replaceStep('mfa');
    }


    /*
     * MFA enrolment (Authenticator or Passkey) has just succeeded. This is
     * the only point at which the account is actually created when MFA is
     * enabled, carrying forward both the email-verification proof and the
     * MFA-verification proof this step produced.
     */
    async function completeMfaSetup({ method, response } = {})
    {
        const mfaVerificationToken =
            response?.mfaVerificationToken ||
            response?.verificationToken ||
            null;

        setMfaCompletion({ method, mfaVerificationToken });

        await createAccount({
            verificationToken: emailVerificationToken,
            mfaVerificationToken,
            mfaMethod: method
        });
    }


    /*
     * The final account-creation call itself failed after MFA had already
     * succeeded (e.g. a transient network/server error). Retry that same
     * final call rather than forcing the user back through email
     * verification and MFA enrolment again.
     */
    function retryAccountCreation()
    {
        if (!mfaCompletion)
            return;

        return createAccount({
            verificationToken: emailVerificationToken,
            mfaVerificationToken: mfaCompletion.mfaVerificationToken,
            mfaMethod: mfaCompletion.method
        });
    }


    function selectPlan(plan)
    {
        if (!plan)
            return;

        if (Debug)
            console.log('selectPlan ', plan);

        setAlert(null);

        if (
            plan.action === 'contact' ||
            plan.requiresBilling === true
        )
        {
            /*
             * Paid-plan checkout is intentionally outside the Free launch path.
             * Switch this branch to the billing step when eCommerce is connected.
             */

//PDS TEST - open a local emailer or a setup page or an eCommerce

            setCommercialInterest(
                `${plan.name || 'ThreatLab commercial services'} - enquiry`
            );

            return;
        }

        setSelectedPlan(plan);
        navigateStep('form');
    }


    function openStreamingOnboarding()
    {
        setAlert(null);
        navigateStep('streaming');
    }


    function continueToVerify(data)
    {
        if (!data)
            return;

        setSignupData(data);
        setAlert(null);
        navigateStep('verify');
    }


    function showTerms()
    {
        if (branding.termsUrl)
        {
            window.open(
                branding.termsUrl,
                '_blank',
                'noopener,noreferrer'
            );

            return;
        }

        setShowTermsModal(true);
    }


    function hideTerms()
    {
        setShowTermsModal(false);
    }


    function backToPricing()
    {
        setAlert(null);

        /*
         * Set the known local destination immediately. The browser-history
         * callback can then update the parent navigation state.
         */
        setStep('pricing');

        if (onNavigateBack)
            onNavigateBack();
    }


    function backToForm()
    {
        setAlert(null);

        /*
         * selectedPlan/signupData are still present during an ordinary Back
         * operation, so returning to the form is valid.
         */
        setStep('form');

        if (onNavigateBack)
            onNavigateBack();
    }


    function renderPricing()
    {
        /*
         * Keep upgrades on the existing SaaS pricing page. The streaming/MDR
         * page is the primary acquisition journey for new ThreatLab users.
         */
        if (!upgradeMode && pricingMode === 'streaming')
        {
            return (
                <SignupPricingStreaming
                    onCancel={onCancel}
                    onLogin={onLogin}
                    onSelectPlan={selectPlan}
                    onStreamingSetup={openStreamingOnboarding}
                    onShowTerms={showTerms}
                />
            );
        }

        return (
            <SignupPricing
                upgradeMode={upgradeMode}
                currentPlan={
                    currentUser?.plan ||
                    currentUser?.subscription ||
                    'free'
                }
                onCancel={onCancel}
                onLogin={upgradeMode ? null : onLogin}
                onSelectPlan={selectPlan}
                onShowTerms={showTerms}
            />
        );
    }


    function renderStep()
    {
        /*
         * These guards MUST remain synchronous.
         *
         * Effects run after rendering. If browser history restores "form",
         * "verify" or "mfa" after a refresh, their transient React state has
         * already disappeared. Rendering the child first would allow it to
         * dereference null before the repair effect can run.
         */

        if (
            step === 'form' &&
            !selectedPlan
        )
        {
            return renderPricing();
        }

        if (
            step === 'verify' &&
            (
                !selectedPlan ||
                !signupData?.email ||
                !signupData?.password
            )
        )
        {
            return renderPricing();
        }

        if (
            step === 'mfa' &&
            (
                !signupData?.email ||
                !signupData?.password ||
                !emailVerificationToken
            )
        )
        {
            return renderPricing();
        }


        if (step === 'streaming')
        {
            if (upgradeMode || pricingMode !== 'streaming')
                return renderPricing();

            return (
                <StreamingOnboarding
                    onBack={backToPricing}
                    onLogin={onLogin}
                    onShowTerms={showTerms}
                    termsVersion={branding.termsVersion}
                />
            );
        }


        if (step === 'form')
        {
            return (
                <SignupForm
                    plan={selectedPlan}
                    initialData={signupData}
                    privacyUrl={branding.privacyUrl}
                    termsUrl={branding.termsUrl}
                    termsVersion={branding.termsVersion}
                    onBack={backToPricing}
                    onDataChange={setSignupData}
                    onContinue={continueToVerify}
                    onLogin={onLogin}
                    onShowTerms={showTerms}
                />
            );
        }


        if (step === 'verify')
        {
            return (
                <SignupVerifyEmail
                    email={signupData.email}
                    plan={selectedPlan}
                    termsVersion={branding.termsVersion}
                    showBusy={showBusy}
                    alert={alert}
                    onBack={backToForm}
                    onClearAlert={() => setAlert(null)}
                    onVerified={handleEmailVerified}
                />
            );
        }


        if (step === 'mfa')
        {
            return (
                <MFASetup
                    email={signupData.email}
                    password={signupData.password}
                    setupToken={emailVerificationToken}
                    initialMethod={
                        signupData.mfaMethod ||
                        'authenticator'
                    }
                    busy={showBusy}
                    alert={alert}
                    onCancel={onLogin}
                    onComplete={completeMfaSetup}
                    onRetry={retryAccountCreation}
                />
            );
        }


        if (step === 'complete')
        {
            return (
                <SignupComplete
                    email={signupData?.email || ''}
                    mfaEnabled={signupData?.mfaEnabled === true}
                    onLogin={onLogin}
                />
            );
        }


        return renderPricing();
    }


    /**
     * RENDER
     */
    return (
        <div className="signup-shell">
            {renderStep()}

            {!branding.termsUrl &&
                <SignupTerms
                    show={showTermsModal}
                    termsVersion={branding.termsVersion}
                    onHide={hideTerms}
                />
            }

            <CommercialContactModal
                open={Boolean(commercialInterest)}
                interest={commercialInterest || 'ThreatLab commercial services'}
                onClose={() => setCommercialInterest(null)}
            />
        </div>
    );
};


export { Signup };